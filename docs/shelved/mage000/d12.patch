+        pts = catmull([base + rake(out * (outf * h * s)
+                                   + Vector((0.0, 0.0, h * s))
+                                   + back * (SPIRE_CURVE * h * s * s))
+                       for s in (0.0, 0.34, 0.70, 1.0)], 5)
+
+        n = len(pts)
+        rings = []
+        for i, p in enumerate(pts):
+            t = i / (n - 1)
+            if i == 0:
