+CROWN_TAPER  = 0.07       # ...and the band is a shallow truncated CONE, not a
+                          # cylinder: its top edge pulls in to follow the hat's
+                          # own taper. A straight cylinder cuts across the cone
+                          # and reads machined on an otherwise all-soft figure.
