+            return 1.0 - SPIRE_SHOULDER_DROP * (t / SPIRE_SHOULDER)
+        u = (t - SPIRE_SHOULDER) / (1.0 - SPIRE_SHOULDER)
+        return (1.0 - SPIRE_SHOULDER_DROP) * (1.0 - u) ** 0.75
