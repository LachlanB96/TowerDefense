+def build_salt_crown():
+    """The Salt Crown of Vael Adrest: a silver circlet crushed over the hat.
+
+    One shallow tapered band riding about 40% of the way up the cone, plus four
+    unequal lens-section blades splayed off the felt and raked backward along the
+    hat's own arc. Everything is built in the crown's own frame and pushed through
+    crown_xf() at the last moment - which adds the circlet's own few degrees of
+    lean on top of the hat's 7.5-degree cock, so ring and blades cannot come apart
+    however either is retuned.
+
+    Four things keep this honest rather than decorative:
+      * The blades SPLAY (the `out` column) and are LONG enough that their tips
+        clear the cone's projected outline into open background. A blade that
+        dies against dark felt does not read as a blade at any size, which is why
+        the azimuths are chosen against the cameras rather than spaced evenly.
+      * They are WIDE - 84 mm at the root, about 5 px at icon size - and taper
+        only over the top third.
+      * Separation is carried by a broad LIT FACET on each blade's outer half,
+        not by a bright edge. A 1 px arris cannot hold a value break at 184.
+      * The ring's tube bites the crown wall and every blade is rooted INSIDE the
+        ring, so nothing here can drift onto the audit's levitation list.
+    """
+    ring_c = Vector((0.0, 0.006, CROWN_Z))
+    lean = Matrix.Rotation(CROWN_LEAN, 3, 'X')
+
+    def crown_xf(p):
+        """Crown-local point -> world.
+
+        Leans the whole assembly about the ring's own centre, then hands off to
+        hat_xf(). Same reasoning as hat_xf itself: leaning the ring but not the
+        blades is the obvious way to get a crown that comes apart, and it would
+        still pass the audit because every piece would touch SOMETHING.
+        """
+        return hat_xf(ring_c + lean @ (Vector(p) - ring_c))
+
+    mseg, nseg = 44, 20
+    # The object rotation reproduces crown_xf exactly for the torus's own
+    # vertices: Blender's default XYZ euler evaluates as Rz@Ry@Rx, so the lean is
+    # applied in the ring's local frame first and the hat's cock second.
+    circlet = add_torus("Hat_Crown_Ring", hat_xf(ring_c),
+                        CROWN_R, CROWN_MINOR,
+                        rot=(CROWN_LEAN, HAT_TILT, 0.0),
+                        mat=M_CROWN, mseg=mseg, nseg=nseg,
+                        scale=(1.0, 1.0, CROWN_SQUASH))
+    # Two jobs in one vertex pass, both about not reading as machined hardware:
+    #   * TAPER the band into a shallow truncated cone that follows the hat's own
+    #     angle. A straight cylinder cuts across the cone and is the one hard
+    #     mechanical edge on an otherwise entirely soft figure.
+    #   * NICK it: hammer one short arc flat, on the drooping side, which is the
+    #     same side the crown has lost its blades over, so both dents tell one
+    #     story. Moving vertices rather than cutting geometry keeps the mesh
+    #     manifold and the audit clean.
