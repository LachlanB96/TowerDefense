+            else:
+                tv = (pts[i + 1] - pts[i - 1]).normalized()
+            # Frame the section by hand instead of reusing frames_along(): a
+            # rotation-minimising frame is seeded from a world axis, so every
+            # blade would come out facing the SAME way regardless of where it
+            # stands on the ring. Gram-Schmidt against the ring's tangent keeps
+            # each blade broadside-on to the viewer it faces.
+            w_ax = (tang - tv * tang.dot(tv)).normalized()
+            d_ax = w_ax.cross(tv).normalized()        # +radially outward
+            # snap < 1 samples the profile short, so the blade ends while it is
+            # still wide - a broken stump instead of a point.
+            # Never let k reach 0 either: a ring collapsed onto a single point
+            # makes the end cap degenerate and both bevel and subsurf misbehave.
+            k = max(0.10, width_at(t * snap))
+            hw, hd = SPIRE_W * wide * k, SPIRE_D * wide * k
+            # The break itself is TORN, not sawn: the top ring of a snapped blade
+            # dips back along its own axis by a few mm, in three lobes round the
+            # section. A flat cut reads as a modelling shortcut and takes the
+            # whole "ancient trophy" story down with it.
+            jag = SPIRE_JAG if (snap < 1.0 and i == n - 1) else 0.0
+            ring = []
+            for j in range(SPIRE_SEGS):
+                a = 2.0 * pi * j / SPIRE_SEGS
+                off = section(a, hw, hd)
+                ring.append(crown_xf(p + w_ax * off[0] + d_ax * off[1]
+                                     - tv * (jag * (0.5 + 0.5
+                                                    * cos(3.0 * a + 2.0)))))
+            rings.append(ring)
+
+        ob = loft("Hat_Spire%d" % idx, rings, mat=M_CROWN,
+                  closed=True, cap_start=True, cap_end=True)
+        me = ob.data
+        me.materials.append(M_CROWN_LIT)   # 1 - the broad lit facet
+        # The whole OUTER half of each blade takes the lighter pewter, not a strip
+        # along its edges. That is the correction that matters most this round: a
+        # bright arris is about a pixel wide at icon size and simply vanishes, so
+        # a blade crossing dark felt had no value break and stopped existing. A
+        # value break needs AREA. Outer half light, inner half dark, and the blade
+        # reads as a solid object with a lit plane and a shaded one.
+        #
+        # loft() emits vertices ring by ring, so a vertex's index modulo
+        # SPIRE_SEGS is the angle it was built at; the outer crest is at
+        # SPIRE_SEGS/4 and the two arrises at 0 and SPIRE_SEGS/2. Deriving the
+        # split from THAT rather than from face order survives a change of ring
+        # count or cap flags; caps are skipped by their vertex count.
+        for poly in me.polygons:
+            if len(poly.vertices) != 4:
+                continue
+            js = sorted(v % SPIRE_SEGS for v in poly.vertices)
+            j = js[0] if js[-1] - js[0] <= 1 else js[-1]   # the wrap face
+            if 0 <= j < SPIRE_SEGS // 2:
+                poly.material_index = 1
