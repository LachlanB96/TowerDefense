+        p = SPIRE_LENS_OUT if s >= 0.0 else SPIRE_LENS_IN
+        d = hd * math.copysign(abs(s) ** p, s)
+        # A raised spine down the middle of the outer face. cos(a) is 0 exactly at
+        # the centre of that face, so a narrow Gaussian on cos(a) rides the blade's
+        # centreline all the way up its length. It splits one broad facet into two
+        # planes meeting at a shallow angle: one takes the key, one does not, and
+        # the value break between them is what makes a nearly-black blade findable
+        # by form now that it can no longer be found by brightness.
+        if s > 0.0:
+            d += hd * SPIRE_RIDGE * math.exp(-(cos(a) / 0.34) ** 2.0)
+        return (hw * cos(a), d)
+
+    for idx, (deg, h, outf, wide, snap) in enumerate(CROWN_SPIRES):
+        phi = radians(deg)
+        out = Vector((cos(phi), sin(phi), 0.0))
+        tang = Vector((-sin(phi), cos(phi), 0.0))
+        # Rooted INSIDE the ring's tube - a few mm in and a few mm down from its
