+CROWN_R      = 0.088      # major radius, and SMALL on purpose. The ring has to
+CROWN_MINOR  = 0.013      # sit down IN the waist the dent cuts, with felt
+                          # rolling proud of it - a ring wider than the cloth
+                          # around it is a hoop parked on a hat.
+                          # Floor: CROWN_R - CROWN_MINOR must stay under the
+                          # DENTED cone radius here (~0.080 at its widest) or the
+                          # circlet stops touching the felt and the audit calls it
+                          # levitating.
