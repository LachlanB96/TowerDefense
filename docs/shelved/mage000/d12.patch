+CROWN_SPIRES = [
+    #  angle  height  out   wide  snap
+    ( 300.0,  0.196,  1.12, 1.00, 1.00),   # tallest, front-right into open sky
+    ( 205.0,  0.150,  0.61, 0.88, 1.00),   # the cocked-up flank
+    (  65.0,  0.126,  0.00, 1.06, 1.00),   # rear-right; rake alone splays it
+    ( 140.0,  0.100,  0.00, 1.18, 0.42),   # rear-left, snapped: broad, torn off
