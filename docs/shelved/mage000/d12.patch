+SPIRE_W     = 0.042       # half-width ACROSS the blade at its root: 84 mm, about
+                          # 5 px at 184. 60 mm was still a smudge. This is the
+                          # single most important number in the block.
+SPIRE_D     = 0.010       # half-depth THROUGH it. Was 0.019, giving a 2.2:1
+                          # section that rendered as a rounded lozenge, petal or
+                          # ear with no thickness anywhere. At 0.010 the blade is
+                          # a 4.2:1 PLATE, which is what "thin plate with a crisp
