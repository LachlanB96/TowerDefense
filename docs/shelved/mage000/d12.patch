+                % (2.0 * pi) - pi)
+        if d < CROWN_NICK_ARC:
+            sc -= CROWN_NICK * (0.5 + 0.5 * cos(pi * d / CROWN_NICK_ARC))
+        v.co.x *= sc
+        v.co.y *= sc
