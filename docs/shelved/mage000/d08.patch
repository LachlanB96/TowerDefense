+    rings = []
+    n = len(frames)
+    for i, (c, out, along) in enumerate(frames):
+        u = i / max(1, n - 1)
+        f = end_taper + (1.0 - end_taper) * sin(pi * (0.06 + 0.88 * u)) ** 0.45
+        ring = []
